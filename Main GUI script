			PageContainer.Visible = false
			btn.Text = "[+]"
		else
			TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = mainSize}):Play()
			task.wait(0.1)
			TabContainer.Visible = true
			PageContainer.Visible = true
			btn.Text = ">_"
