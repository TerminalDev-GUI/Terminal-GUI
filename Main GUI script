	local Stroke = Instance.new("UIStroke", Main)
	Stroke.Thickness, Stroke.ApplyStrokeMode = 3, 1
	AddCorner(Main, UDim.new(0, 8))
	Instance.new("UIDragDetector", Main)
	
	-- RAINBOW OUTLINE LOOP SYSTEM
	task.spawn(function()
		local h = 0
		while Main.Parent do
			h = (h + 0.005) % 1
			Stroke.Color = Color3.fromHSV(h, 1, 1)
			task.wait()
		end
	end)
	
	-- AUTOMATIC BORDER PARTICLE EMITTER
	task.spawn(function()
		while Main.Parent do
			task.wait(0.08)
			if Main.Visible and Main.AbsoluteSize.X > 0 and not isMin then
				local P = Instance.new("TextLabel", Screen)
				P.BackgroundTransparency = 1
				P.Font = Enum.Font.Code
				P.Text = "★"
				P.TextSize = math.random(10, 16)
				P.TextColor3 = Stroke.Color
				P.ZIndex = Main.ZIndex - 1
				
				local edgeX = math.random(0, Main.AbsoluteSize.X)
				local edgeY = math.random(0, Main.AbsoluteSize.Y)
				
				local wall = math.random(1, 4)
				if wall == 1 then edgeY = 0
				elseif wall == 2 then edgeY = Main.AbsoluteSize.Y
				elseif wall == 3 then edgeX = 0
				elseif wall == 4 then edgeX = Main.AbsoluteSize.X
				end
				
				P.Position = UDim2.fromOffset(Main.AbsolutePosition.X + edgeX, Main.AbsolutePosition.Y + edgeY)
				P.Size = UDim2.fromOffset(20, 20)
				
				local centerX = Main.AbsolutePosition.X + (Main.AbsoluteSize.X / 2)
				local centerY = Main.AbsolutePosition.Y + (Main.AbsoluteSize.Y / 2)
				local dirX = (P.AbsolutePosition.X - centerX) * math.random(1.2, 1.8)
				local dirY = (P.AbsolutePosition.Y - centerY) * math.random(1.2, 1.8)
				
				local targetPos = P.Position + UDim2.fromOffset(dirX, dirY)
				local t = TweenService:Create(P, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = targetPos,
					TextTransparency = 1,
					Rotation = math.random(-180, 180)
				})
				t:Play()
				t.Completed:Connect(function() P:Destroy() end)
			end
		end
	end)
	
	local Title = Instance.new("TextLabel", Main)
	Title.Size, Title.Position = UDim2.new(1, -40, 0, 35), UDim2.fromOffset(10, 0)
	Title.BackgroundTransparency, Title.Font = 1, Enum.Font.Code
	Title.Text, Title.TextSize, Title.TextXAlignment = "TERMINAL GUI", 15, 0
	Title.TextColor3 = Color3.fromRGB(255, 255, 255)

	local btn = Instance.new("TextButton", Main)
	btn.Size, btn.Position = UDim2.fromOffset(30, 30), UDim2.new(1, -35, 0, 5)
	btn.BackgroundTransparency, btn.Font, btn.Text, btn.TextSize = 1, 3, ">_", 18
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	AddCorner(btn)

	local TabContainer = Instance.new("Frame", Main)
	TabContainer.Size, TabContainer.Position = UDim2.new(0, 70, 1, -45), UDim2.fromOffset(5, 40)
	TabContainer.BackgroundTransparency = 1

	local PageContainer = Instance.new("ScrollingFrame", Main)
	PageContainer.Size, PageContainer.Position = UDim2.new(1, -85, 1, -45), UDim2.fromOffset(80, 40)
	PageContainer.BackgroundTransparency, PageContainer.BorderSizePixel, PageContainer.ScrollBarThickness = 1, 0, 2
